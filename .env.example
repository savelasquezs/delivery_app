# Copiar a .env y ajustar según cómo ejecutes la app.

# --- Local (emulador Android) ---
# API_BASE_URL=http://10.0.2.2:8080/api
# SIGNALR_HUB_URL=http://10.0.2.2:8080/hubs/orders

# --- Local (teléfono en la misma WiFi; usa la IP de tu PC) ---
# API_BASE_URL=http://192.168.0.XXX:8080/api
# SIGNALR_HUB_URL=http://192.168.0.XXX:8080/hubs/orders

# --- Railway ---
# API_BASE_URL=https://senorarrozapi.up.railway.app/api
# SIGNALR_HUB_URL=https://senorarrozapi.up.railway.app/hubs/orders

# URL pública del manifiesto de actualización (mismo JSON que senorArrozFront/public/delivery-app-release.json).
# Si se omite o queda vacío, la app no comprueba actualizaciones.
# DELIVERY_APP_UPDATE_MANIFEST_URL=https://tu-dominio.com/delivery-app-release.json
